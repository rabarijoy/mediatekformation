{% extends "basefront.html.twig" %}
{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    <div class="row mt-3">
        <div class="col">
            <h4 class="text-info mt-5">{{ playlist.name }}</h4>
            <strong>catégories : </strong>
                {% for cat in playlistcategories %}
                    {{ cat.name }}&nbsp;
                {% endfor %}
            <br /><br />
            <strong>nombre de formations : </strong>
            {{ playlist.nombreformations }}
            <br /><br />
            <strong>description :</strong><br />
                {{ playlist.description|nl2br }}
            <br /><br />

            {# Bloc inscription / statut / désincription #}
            {% if is_granted('ROLE_USER') %}
                {% if inscription %}
                    <div class="alert
                        {% if inscription.statut == 'Certificat obtenu' %}alert-success
                        {% elseif inscription.statut == 'Échec' %}alert-danger
                        {% else %}alert-secondary{% endif %} d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Votre statut :</strong> {{ inscription.statut }}
                            {% if inscription.note is not null %}
                                — Note : {{ inscription.note }}/100
                                {% if playlist.seuilReussite is not null %}
                                    (seuil : {{ playlist.seuilReussite }}/100)
                                {% endif %}
                            {% endif %}
                        </div>
                        <form method="post" action="{{ path('playlists.desinscription', {id: playlist.id}) }}" class="ms-3">
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('Confirmer la désinscription de cette formation ?');">
                                Se désinscrire
                            </button>
                        </form>
                    </div>
                {% else %}
                    <form method="post" action="{{ path('playlists.inscrire', {id: playlist.id}) }}">
                        <button type="submit" class="btn btn-primary"
                                onclick="return confirm('Confirmer votre inscription à la formation « {{ playlist.name }} » ?');">
                            S'inscrire à cette formation
                        </button>
                    </form>
                {% endif %}
            {% else %}
                <button type="button" class="btn btn-secondary" disabled
                        title="Vous devez être connecté pour vous inscrire">
                    S'inscrire à cette formation
                </button>
                <small class="text-muted d-block mt-1">
                    <a href="{{ path('front_login') }}">Connectez-vous</a> pour vous inscrire.
                </small>
            {% endif %}
        </div>
        <div class="col">
            <!-- boucle sur l'affichage des formations -->
            {% for formation in playlistformations %}
                <div class="row mt-1">
                    <div class="col-md-auto">
                        {% if formation.miniature %}
                            <a href="{{ path('formations.showone', {id:formation.id}) }}">
                                <img src="{{ formation.miniature }}" alt="Miniature de la formation {{ formation.title }}">
                            </a>
                        {% endif %}  
                    </div>
                    <div class="col d-flex align-items-center">
                        <a href="{{ path('formations.showone', {id:formation.id}) }}" 
                           class="link-secondary text-decoration-none">
                            {{ formation.title }}
                        </a>          
                    </div>
                </div>
            {% endfor %}
        </div>
        
    </div>
{% endblock %}
